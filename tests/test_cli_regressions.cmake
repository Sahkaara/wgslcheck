function(check_case name command source expected diagnostic)
    set(path "${CMAKE_CURRENT_BINARY_DIR}/cli-${name}.wgsl")
    file(WRITE "${path}" "${source}")
    execute_process(COMMAND "${EXECUTABLE}" "${command}" "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected exit ${expected}, got ${result}: ${error}")
    endif()
    if(NOT "${diagnostic}" STREQUAL "" AND NOT error MATCHES "${diagnostic}")
        message(FATAL_ERROR "${name}: diagnostic absent: ${error}")
    endif()
endfunction()

check_case(unknown-variable check "fn main() { let x = missing; }" 2 "unknown variable")
check_case(unknown-function check "fn main() { missing(); }" 2 "unknown or unsupported function")
check_case(arity check "fn helper(x: u32) {} fn main() { helper(); }" 2 "wrong number")
check_case(workgroup check "@workgroup_size(1) fn helper() {}" 2 "only valid on compute")
check_case(numeric sim "@compute @workgroup_size(1) fn main() { if (u32(3.9f) != 3u || 5u / 2u != 2u) { let x = 1/0; } }" 0 "")
check_case(unsupported-f16 sim "@compute @workgroup_size(1) fn main() { let x = f16(1); }" 2 "f16 simulation is not supported")
